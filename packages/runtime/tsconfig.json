{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "src/*": ["./src/*"],
      "@repo/runtime/src/*": ["./src/*"]
    },
    "types": ["bun"]
  },
  "include": ["src/**/*", "vendor/**/*", "shims/**/*", "package.json"],
  "exclude": ["**/node_modules/**", "../../node_modules/**", "../../../node_modules/**"]
}
